# Copy to .env and change the password. Never commit .env.

# --- Postgres ---
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sandbox
# Host port for the DB (change if you already run Postgres locally on 5432).
POSTGRES_HOST_PORT=5432

# --- Ollama ---
OLLAMA_HOST_PORT=11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b
# 0 = deterministic (greedy) answers; raise it only to experiment with sampling.
LLM_TEMPERATURE=0

# --- Dev option (macOS): native Ollama instead of the container ---
# Uncomment to make `docker compose` use docker-compose.native-ollama.yml by
# default. Run `docker compose stop ollama` first so native Ollama can use
# port 11434. Leave commented for the offline demo.
# COMPOSE_FILE=docker-compose.yml:docker-compose.native-ollama.yml

# --- Only used when running Python scripts on the host (outside Compose) ---
# Inside Compose these are overridden to the service names `db` and `ollama`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
OLLAMA_BASE_URL=http://localhost:11434
POLICIES_DIR=data/policies

# Copy to .env and change the password. Never commit .env.

# --- Postgres ---
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sandbox

# --- Ollama ---
# Host (loopback) ports published by the ingress proxy. The DB and Ollama
# have no host ports: they live on the isolated `sandbox` network.
BACKEND_HOST_PORT=8000
# Host port for the Streamlit dashboard.
DASHBOARD_HOST_PORT=8501
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b
# 0 = deterministic (greedy) answers; raise it only to experiment with sampling.
LLM_TEMPERATURE=0
# Upper bound on generated tokens per answer (bounds worst-case latency).
LLM_MAX_TOKENS=256

# --- Dev option (macOS): native Ollama instead of the container ---
# Uncomment to make `docker compose` use docker-compose.native-ollama.yml by
# default. Not network-isolated (see that file). Leave commented for the
# offline demo and the air-gap proof.
# COMPOSE_FILE=docker-compose.yml:docker-compose.native-ollama.yml

# --- Host-side scripts ---
# The DB and Ollama have no host ports, so scripts that need them run in the
# `tools` container (docker compose run --rm tools python scripts/...), which
# gets its settings from Compose. These values only matter for host-run code
# that imports the backend settings without a database (e.g. eval_detector.py).
POLICIES_DIR=data/policies
